#pragma once

// Test-only WASM import; production ARM uses the standard math library.
extern "C" __attribute__((import_module("env"), import_name("pokerogueTestPow")))
double pokerogueTestPow(double, double);
namespace std {
inline bool isfinite(double x) { return __builtin_isfinite(x); }
inline double ceil(double x) { return __builtin_ceil(x); }
inline double round(double x) { return __builtin_round(x); }
inline double pow(double x, double y) { return pokerogueTestPow(x, y); }

inline float round(float x) {
    return (x >= 0.0f) ? (float)(int)(x + 0.5f) : (float)(int)(x - 0.5f);
}

inline float fabs(float x) {
    return (x < 0.0f) ? -x : x;
}

inline float fmax(float a, float b) {
    return (a > b) ? a : b;
}

inline float fmin(float a, float b) {
    return (a < b) ? a : b;
}

inline float floor(float x) {
    int i = (int)x;
    return (x < (float)i) ? (float)(i - 1) : (float)i;
}

inline double floor(double x) {
    long long i = (long long)x;
    return (x < (double)i) ? (double)(i - 1) : (double)i;
}
}

using std::floor;
using std::round;
using std::fabs;
using std::fmax;
using std::fmin;
