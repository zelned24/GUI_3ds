# GUI_3DS - devkitARM / Citro2D Real 3DS Build System
# Conforms to official devkitPro 3DS rules

ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>devkitPro. BLOCKED — missing toolchain/dependency")
endif

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM. BLOCKED — missing toolchain/dependency")
endif

include $(DEVKITARM)/3ds_rules

TARGET      := GUI_3DS
BUILD       := build
SOURCES     := project/src project/src/game project/src/gfx project/src/runtime project/src/storage project/src/content project/generated/src/screens project/vendor/quickjs
INCLUDES    := project/include project/vendor/quickjs project/generated/include $(CTRULIB)/include $(DEVKITPRO)/libctru/include $(DEVKITPRO)/portlibs/3ds/include
ROMFS       := build/romfs

ARCH        := -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=cp15
CFLAGS      := -g -Wall -O2 -MMD -MP -mword-relocations \
               -fomit-frame-pointer -ffunction-sections \
               $(ARCH) -D__3DS__ -D_3DS -DARM11 -DPOKEROGUE_ENABLE_QUICKJS

CXXFLAGS    := $(CFLAGS) -fno-rtti -fno-exceptions -std=gnu++17

ASFLAGS     := -g $(ARCH)
LIBDIRS     := -L$(CTRULIB)/lib -L$(DEVKITPRO)/libctru/lib -L$(DEVKITPRO)/portlibs/3ds/lib
LDFLAGS     := -specs=3dsx.specs -g $(ARCH) $(LIBDIRS) -Wl,-Map,$(BUILD)/$(TARGET).map

LIBS        := -lcitro2d -lcitro3d -lctru -lm

_3DSXTOOL   := $(shell which 3dsxtool 2>/dev/null || echo $(DEVKITPRO)/tools/bin/3dsxtool)
_SMDHTOOL   := $(shell which smdhtool 2>/dev/null || echo $(DEVKITPRO)/tools/bin/smdhtool)

_ICON       := $(firstword $(wildcard icon.png $(CTRULIB)/default_icon.png $(DEVKITPRO)/libctru/default_icon.png))

APP_TITLE       := GUI_3DS
APP_DESCRIPTION := PokéRogue 3DS Scene Composer
APP_AUTHOR      := zelned24

CFILES      := $(foreach dir,$(SOURCES),$(wildcard $(dir)/*.c))
CPPFILES    := $(filter-out %ExampleScreen.cpp,$(foreach dir,$(SOURCES),$(wildcard $(dir)/*.cpp)))
OFILES      := $(CFILES:%.c=$(BUILD)/%.o) $(CPPFILES:%.cpp=$(BUILD)/%.o)

-include $(OFILES:.o=.d)

.PHONY: all 3ds clean

all: 3ds

3ds: $(BUILD)/$(TARGET).3dsx

$(BUILD)/$(TARGET).smdh: $(_ICON)
	@mkdir -p $(dir $@)
	@echo "Creating SMDH descriptor using smdhtool..."
	$(_SMDHTOOL) --create "$(APP_TITLE)" "$(APP_DESCRIPTION)" "$(APP_AUTHOR)" $(_ICON) $@

$(BUILD)/$(TARGET).3dsx: $(BUILD)/$(TARGET).elf $(BUILD)/$(TARGET).smdh
	@echo "Creating 3DSX with RomFS using 3dsxtool..."
	$(_3DSXTOOL) $< $@ --smdh=$(BUILD)/$(TARGET).smdh $(if $(wildcard $(ROMFS)),--romfs=$(ROMFS),)

$(BUILD)/$(TARGET).elf: $(OFILES)
	@echo "Linking 3DS ELF..."
	$(CXX) $(LDFLAGS) $(OFILES) $(LIBS) -o $@

$(BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	@echo "Compiling $<..."
	@$(CXX) $(CXXFLAGS) $(foreach inc,$(INCLUDES),-I$(inc)) -c $< -o $@

# Official 2024-01-13 archive SHA256:
# 3c4bf8f895bfa54beb486c8d1218112771ecfc5ac3be1036851ef41568212e03
# CONFIG_BIGNUM is tested with #ifdef: leave undefined, never define it as 0.
# Vendor stays byte-for-byte original. Disable its internal Atomics define only
# in a generated compilation copy; retain CONFIG_STACK_CHECK for ARM11.
$(BUILD)/project/vendor/quickjs/quickjs.o: project/vendor/quickjs/quickjs.c
	@mkdir -p $(dir $@)
	@sed '/^#define CONFIG_ATOMICS$$/d' $< > $(dir $@)quickjs-no-atomics.c
	@$(CC) $(ARCH) -O2 -MMD -MP -mword-relocations -fomit-frame-pointer -ffunction-sections \
	       -D__3DS__ -D_3DS -DARM11 -UCONFIG_BIGNUM -UCONFIG_ATOMICS \
	       -DCONFIG_VERSION=\"2024-01-13\" -Iproject/vendor/quickjs \
	       -c $(dir $@)quickjs-no-atomics.c -o $@

$(BUILD)/project/vendor/quickjs/%.o: project/vendor/quickjs/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(ARCH) -O2 -MMD -MP -mword-relocations -fomit-frame-pointer -ffunction-sections \
	       -D__3DS__ -D_3DS -DARM11 -UCONFIG_BIGNUM -UCONFIG_ATOMICS \
	       -DCONFIG_VERSION=\"2024-01-13\" -Iproject/vendor/quickjs -c $< -o $@

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "Compiling $<..."
	@$(CC) $(CFLAGS) $(foreach inc,$(INCLUDES),-I$(inc)) -c $< -o $@

clean:
	@rm -rf $(BUILD)
